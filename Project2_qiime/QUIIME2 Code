# Create a directory for your project and navigate to it
mkdir /data/dep1
cd /../data/dep1

#upload the sequences, manifest and metadata files into that folder 

#manifest import
qiime tools import \
  --type "SampleData[SequencesWithQuality]" \
  --input-format SingleEndFastqManifestPhred33V2 \
  --input-path new_manifest_final.tsv \
  --output-path ./demux_seqs.qza

# Create visualization of demultiplexed samples
qiime demux summarize \
  --i-data demux_seqs.qza \
  --o-visualization demux_seqs.qzv
 
# Copy file from your computer terminal
scp root@10.19.139.162:/data/dep1/demux_seqs.qzv .
#and then see where to trim

# Determine ASVs with DADA2 
qiime dada2 denoise-single \
  --i-demultiplexed-seqs demux_seqs.qza \
  --p-trim-left 0 \
  --p-trunc-len 150 \
  --o-representative-sequences rep-seqs.qza \
  --o-table table.qza \
  --o-denoising-stats stats.qza

# Visualize ASVs stats
qiime feature-table summarize \
  --i-table table.qza \
  --o-visualization table.qzv \
  --m-sample-metadata-file metadata_final_amb.tsv

qiime feature-table tabulate-seqs \
  --i-data rep-seqs.qza \
  --o-visualization rep-seqs.qzv
 
 
#copying to local computer
# Copy file
scp root@10.19.139.162:/data/dep1/table.qzv .
scp root@10.19.139.162:/data/dep1/rep-seqs.qzv .

# Taxonomic analysis 
qiime feature-classifier classify-sklearn \
  --i-classifier /datasets/classifiers/silva-138-99-515-806-nb-classifier.qza \
  --i-reads rep-seqs.qza \
  --o-classification taxonomy.qza
 
qiime metadata tabulate \
  --m-input-file taxonomy.qza \
  --o-visualization taxonomy.qzv
 
# Taxonomy barplots
qiime taxa barplot \
  --i-table table.qza \
  --i-taxonomy taxonomy.qza \
  --m-metadata-file metadata_final_amb.tsv \
  --o-visualization taxa-bar-plots.qzv
 
#input into our computer
scp root@10.19.139.162:/data/dep1/taxa-bar-plots.qzv .

#filter out mit DNA
qiime taxa filter-table \
--i-table table.qza \
--i-taxonomy taxonomy.qza \
--p-exclude mitochondria,chloroplast \
--o-filtered-table table-no-mitochondria-no-chloroplast.qza

#may need to filter out using feature frequency or other metadata but this was not done because it was noted before that this step removed rare asv’s in previous projects
qiime feature-table summarize \
  --i-table table-no-mitochondria-no-chloroplast.qza \
  --o-visualization table-no-mitochondria-no-chloroplast.qzv \
  --m-sample-metadata-file metadata_final_amb.tsv

#input into our computer
scp root@10.19.139.162:/data/dep1/table-no-mitochondria-no-chloroplast.qzv .
 
# Generate a tree for phylogenetic diversity analyses
qiime phylogeny align-to-tree-mafft-fasttree \
  --i-sequences rep-seqs.qza \
  --o-alignment aligned-rep-seqs.qza \
  --o-masked-alignment masked-aligned-rep-seqs.qza \
  --o-tree unrooted-tree.qza \
  --o-rooted-tree rooted-tree.qza

# Alpha-rarefaction
qiime diversity alpha-rarefaction \
  --i-table table.qza \
  --i-phylogeny rooted-tree.qza \
  --p-max-depth 20000 \
  --m-metadata-file metadata_final_amb.tsv \
  --o-visualization alpha-rarefaction.qzv
 #pick max depth that is close to but less than the maximum frequency per sample in the filtered table w/o mit

#move to computer
scp root@10.19.139.162:/data/dep1/alpha-rarefaction.qzv .
