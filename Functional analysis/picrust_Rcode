library(tidyverse)
library(phyloseq)
library(ggpicrust2)
library(readr)
library(tibble)
library(ggprism)
library(patchwork)
library(devtools)

meta <- read.delim("metadata_final_amb.tsv") %>% 
  data.frame() %>% filter(row_number() <= n()-1)
  
ko <- read.delim('pred_metagenome_unstrat.tsv', row.names = 1)


 #comparsion of age for depressed dep_hyp_age_comparison
 dep_hyp_age_comparison <- meta %>% filter(dep_hyp_age %in% 
                                 c("depressed_hypertension_60 and older", 
   "depressed_hypertension_under 60"))
 
 ko_filtered_dep_hyp_age_comparison <- ko %>% select(all_of(dep_hyp_age_comparison$sample.id))
 
 dep_hyp_age_comparison_daa_results_df = pathway_daa(abundance = ko_filtered_dep_hyp_age_comparison,
                              metadata = dep_hyp_age_comparison,
                              group = "dep_hyp_age",
                              daa_method = "LinDA",
                              select = NULL, reference = NULL)
 
 dep_hyp_age_daa_annotated_results_df <- pathway_annotation(pathway = "KO",
                                        daa_results_df = dep_hyp_age_comparison_daa_results_df,
                                        ko_to_kegg = TRUE)
 
 saveRDS(dep_hyp_age_daa_annotated_results_df,"dep_hyp_age_daa_annotated_results_df.rds")
dep_hyp_age_daa_annotated_results_df <- readRDS("dep_hyp_age_daa_annotated_results_df.rds")


